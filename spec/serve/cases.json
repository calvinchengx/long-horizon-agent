{
  "description": "The UI API's conformance cases (spec/serve/README.md). Each runs against fixture.json; `temporal` limits a case to a server with Temporal unreachable (`absent`) or with the fake mission workflow running (`running`). Body expectations are subsets.",
  "cases": [
    {
      "name": "health",
      "operation": "getHealth",
      "request": {
        "method": "GET",
        "path": "/api/v1/health"
      },
      "expect": {
        "status": 200,
        "body": {
          "api_version": "1.0.0",
          "store": {
            "backend": "sqlite",
            "degraded_reason": ""
          }
        }
      }
    },
    {
      "name": "health with the cookie",
      "operation": "getHealth",
      "request": {
        "method": "GET",
        "path": "/api/v1/health",
        "auth": "cookie"
      },
      "expect": {
        "status": 200
      }
    },
    {
      "name": "health reports an unreachable Temporal",
      "operation": "getHealth",
      "request": {
        "method": "GET",
        "path": "/api/v1/health"
      },
      "expect": {
        "status": 200,
        "body": {
          "temporal": "unavailable"
        }
      },
      "temporal": "absent"
    },
    {
      "name": "health reports a reachable Temporal",
      "operation": "getHealth",
      "request": {
        "method": "GET",
        "path": "/api/v1/health"
      },
      "expect": {
        "status": 200,
        "body": {
          "temporal": "connected"
        }
      },
      "temporal": "running"
    },
    {
      "name": "no token",
      "operation": "getHealth",
      "request": {
        "method": "GET",
        "path": "/api/v1/health",
        "auth": "none"
      },
      "expect": {
        "status": 401,
        "error": "unauthorized"
      }
    },
    {
      "name": "a wrong token",
      "operation": "getHealth",
      "request": {
        "method": "GET",
        "path": "/api/v1/health",
        "auth": "wrong"
      },
      "expect": {
        "status": 401,
        "error": "unauthorized"
      }
    },
    {
      "name": "a foreign Host (DNS rebinding)",
      "operation": "getHealth",
      "request": {
        "method": "GET",
        "path": "/api/v1/health",
        "host": "evil.example:80"
      },
      "expect": {
        "status": 403,
        "error": "forbidden_host"
      }
    },
    {
      "name": "an undocumented path",
      "operation": "",
      "request": {
        "method": "GET",
        "path": "/api/v1/nope"
      },
      "expect": {
        "status": 404,
        "error": "not_found"
      }
    },
    {
      "name": "list missions",
      "operation": "listMissions",
      "request": {
        "method": "GET",
        "path": "/api/v1/missions"
      },
      "expect": {
        "status": 200,
        "body": {
          "missions": {
            "$len": 4
          }
        }
      }
    },
    {
      "name": "a mission's summary counts its items and spend",
      "operation": "listMissions",
      "request": {
        "method": "GET",
        "path": "/api/v1/missions"
      },
      "expect": {
        "status": 200,
        "body": {
          "missions": {
            "$contains": [
              {
                "mission_id": "mission_local",
                "durable": false,
                "workflow_id": null,
                "items": {
                  "total": 4,
                  "todo": 1,
                  "in_progress": 1,
                  "blocked": 1,
                  "done": 1,
                  "split": 0
                },
                "spend": {
                  "calls": 2,
                  "known_usd": 0.006,
                  "unknown_cost_calls": 1,
                  "input_tokens": 1500,
                  "output_tokens": 250
                },
                "last_event": {
                  "id": 36,
                  "kind": "verify",
                  "ts": "2026-10-04T00:00:35.000000+00:00"
                }
              },
              {
                "mission_id": "mission_elsewhere",
                "items": null,
                "last_event": null
              },
              {
                "mission_id": "mission_durable",
                "durable": true,
                "workflow_id": "mission:mission_durable",
                "last_event": {
                  "id": 38
                }
              }
            ]
          }
        }
      }
    },
