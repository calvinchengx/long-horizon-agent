          "arg": 900
        }
      },
      "temporal": "running"
    },
    {
      "name": "snooze_mission: a finished mission",
      "request": {
        "body": {
          "jsonrpc": "2.0",
          "id": 35,
          "method": "tools/call",
          "params": {
            "name": "snooze_mission",
            "arguments": {
              "mission_id": "mission_finished",
              "seconds": 900
            }
          }
        }
      },
      "expect": {
        "tool_error": "finished"
      }
    },
    {
      "name": "http: the bearer token",
      "request": {
        "body": {
          "jsonrpc": "2.0",
          "id": 36,
          "method": "ping"
        },
        "auth": "bearer"
      },
      "expect": {
        "status": 200,
        "result": {}
      },
      "transport": "http"
    },
    {
      "name": "http: no token",
      "request": {
        "body": {
          "jsonrpc": "2.0",
          "id": 37,
          "method": "ping"
        },
        "auth": "none"
      },
      "expect": {
        "status": 401
      },
      "transport": "http"
    },
    {
      "name": "http: a wrong token",
      "request": {
        "body": {
          "jsonrpc": "2.0",
          "id": 38,
          "method": "ping"
        },
        "auth": "wrong"
      },
      "expect": {
        "status": 401
      },
      "transport": "http"
    },
    {
      "name": "http: the cookie alone cannot call tools",
      "request": {
        "body": {
          "jsonrpc": "2.0",
          "id": 39,
          "method": "ping"
        },
        "auth": "cookie"
      },
      "expect": {
        "status": 401
      },
      "transport": "http"
    },
    {
      "name": "http: a foreign Host",
      "request": {
        "body": {
          "jsonrpc": "2.0",
          "id": 40,
          "method": "ping"
        },
        "host": "evil.example:80"
      },
      "expect": {
        "status": 403
      },
      "transport": "http"
    },
    {
      "name": "http: GET opens no stream",
      "request": {
        "body": null,
        "method": "GET"
      },
      "expect": {
        "status": 405
      },
      "transport": "http"
    }
  ]
}
