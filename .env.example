# Copy to .env and fill in. All settings are read via lha.config.Settings (prefix LHA_).
# Defaults run at $0 (stub model). The default sandbox is docker; LHA_SANDBOX=local also needs
# LHA_ALLOW_UNSAFE_LOCAL=true (no isolation). Everything below is optional.

# --- Model backend: stub | ollama | openai_compat | claude ---
LHA_MODEL_BACKEND=stub
LHA_MODEL_NAME=stub-1

# Ollama (local, $0): backend=ollama, model=e.g. qwen2.5-coder:7b
LHA_OLLAMA_BASE_URL=http://localhost:11434

# OpenAI-compatible (Groq / Gemini / OpenRouter / ...): backend=openai_compat
# LHA_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LHA_OPENAI_API_KEY=
# USD per 1M tokens for LHA_MODEL_NAME (set both or neither). Unset => cost is UNKNOWN (never $0)
# and the budget governor refuses the call unless LHA_ALLOW_UNPRICED_MODELS=true.
# LHA_OPENAI_PRICE_IN_PER_MTOK=0.59
# LHA_OPENAI_PRICE_OUT_PER_MTOK=0.79

# Claude: backend=claude, model=claude-sonnet-4-6 | claude-opus-4-8 | claude-haiku-4-5-20251001
# LHA_ANTHROPIC_API_KEY=
# Optional explicit prices (USD per 1M tokens) overriding the built-in table for LHA_MODEL_NAME only.
# LHA_CLAUDE_PRICE_IN_PER_MTOK=3.0
# LHA_CLAUDE_PRICE_OUT_PER_MTOK=15.0

# --- Durable spine (Temporal) ---
LHA_TEMPORAL_ADDRESS=localhost:7233
LHA_TEMPORAL_NAMESPACE=default
LHA_TASK_QUEUE=lha-mission

# --- Persistence: missions, cost ledger, episodic events, memory, skills ---
# Unset LHA_POSTGRES_DSN = a local SQLite file (WAL mode) at LHA_SQLITE_PATH; unset, one per-user
# file every process shares ($XDG_DATA_HOME/lha/lha.sqlite3, else ~/Library/Application
# Support/lha/lha.sqlite3 on macOS or ~/.local/share/lha/lha.sqlite3). Use an absolute path: a
# relative one resolves against each process's working directory. `lha config` prints the
# resolved location. Set LHA_POSTGRES_DSN = Postgres (+ pgvector); run `lha db migrate` first and install the
# `postgres` extra. If Postgres is unusable the run warns and falls back to SQLite, unless
# LHA_POSTGRES_FALLBACK_TO_SQLITE=false.
# LHA_POSTGRES_DSN=postgresql://lha:lha@localhost:5432/lha
# LHA_SQLITE_PATH=/absolute/path/lha.sqlite3
LHA_POSTGRES_FALLBACK_TO_SQLITE=true
LHA_WORKSPACE_ROOT=.lha/workspaces
LHA_OBJECT_STORE_ROOT=.lha/objects

# --- Tiered memory in the lead's prompt (see docs/12-memory.md) ---
LHA_MEMORY_ENABLED=true
LHA_MEMORY_PROMPT_BUDGET_CHARS=4000
# hash (offline, no extra, lexical) | ollama (semantic, $0: a local Ollama at LHA_OLLAMA_BASE_URL
# with the model pulled; lexical-only if absent) | sentence_transformers (needs the `embeddings`
# extra) | none (lexical)
LHA_MEMORY_EMBEDDER=hash
# Empty: nomic-embed-text for ollama, BAAI/bge-m3 for sentence_transformers
# LHA_MEMORY_EMBEDDING_MODEL=
# Consolidate episodes into facts every N cycles (0 = off); extractive (free) | model (metered)
LHA_MEMORY_CONSOLIDATE_EVERY=5
LHA_MEMORY_CONSOLIDATION=extractive

# --- Governor (cost / loop guards) ---
LHA_BUDGET_USD_CEILING=10.0
LHA_MAX_CYCLES=1000
LHA_MAX_TURNS_PER_CYCLE=8
LHA_STALL_LIMIT=5
# Allow models whose cost cannot be computed (spend becomes unverifiable). Default: refuse.
LHA_ALLOW_UNPRICED_MODELS=false

# --- Observability (optional) ---
# LHA_LANGFUSE_HOST=http://localhost:3000
# LHA_LANGFUSE_PUBLIC_KEY=
# LHA_LANGFUSE_SECRET_KEY=
